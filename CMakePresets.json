{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug + AddressSanitizer",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "HK_ASAN": "ON" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (LTO)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer + AddressSanitizer",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "HK_FUZZ": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
